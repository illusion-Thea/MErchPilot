# 文件职责：提供本地 Docker 全量运行所需的环境变量模板；复制为 .env 后按机器路径调整。

# 应用运行模式、跨域来源与依赖安装源。
APP_ENV=development
APP_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://192.168.12.28:3001,http://192.168.12.76:3001
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_DEFAULT_TIMEOUT=180
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.7.1

# 宿主机暴露端口；容器内部端口由 docker-compose.yml 固定管理。
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MILVUS_HOST_PORT=19532
MILVUS_METRICS_HOST_PORT=9092
API_HOST_PORT=8000
MCP_HOST_PORT=8001
WEB_HOST_PORT=3001
EMBEDDING_HOST_PORT=8110
RERANKER_HOST_PORT=8111

# PostgreSQL 业务库与隔离的集成测试库连接信息。
POSTGRES_DB=merchpilot
POSTGRES_USER=merchpilot
POSTGRES_PASSWORD=merchpilot
DATABASE_URL=postgresql+asyncpg://merchpilot:merchpilot@postgres:5432/merchpilot
TEST_DATABASE_URL=postgresql+asyncpg://merchpilot:merchpilot@127.0.0.1:5432/merchpilot_test

# 数据库连接池、慢查询与跨实例并发控制。
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_SLOW_QUERY_THRESHOLD_MS=500
REDIS_LOCK_TIMEOUT_SECONDS=900
DISTRIBUTED_LOCK_FAIL_OPEN=true
PROJECT_DISTRIBUTED_LOCK_ENABLED=true
RUN_DISTRIBUTED_LOCK_ENABLED=true
AGENT_DISTRIBUTED_LOCK_ENABLED=true

# API 进程、Redis 限流和拆分 Worker 的并发参数。
API_WORKERS=2
API_KEEPALIVE_SECONDS=5
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_TENANT_REQUESTS=5000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true
PLANNING_WORKER_CONCURRENCY=2
INDEX_WORKER_CONCURRENCY=1
REPORT_WORKER_CONCURRENCY=2
MODEL_SERVICE_MAX_CONCURRENCY=1
MODEL_SERVICE_QUEUE_TIMEOUT_SECONDS=2
MODEL_SERVICE_FAILURE_THRESHOLD=5
MODEL_SERVICE_CIRCUIT_OPEN_SECONDS=30
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0

# Redis 分库：0 保存应用状态，1 用作 Celery Broker，2 保存 Celery 结果。
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=mp
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
APPROVAL_SLA_HOURS=24

# Milvus 与本地向量/重排模型服务配置。
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=merchpilot_evidence_hybrid_v2
MILVUS_HYBRID_SEARCH_ENABLED=true
MILVUS_DENSE_WEIGHT=0.65
MILVUS_SPARSE_WEIGHT=0.35
EMBEDDING_SERVICE_URL=http://embedding-service:8100
RERANKER_SERVICE_URL=http://reranker-service:8100
RETRIEVAL_TIMEOUT_SECONDS=3
MODEL_SERVICE_TIMEOUT_SECONDS=120
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
MAX_IMPORT_FILE_BYTES=52428800
MULTIMODAL_MAX_PAGES=50
MULTIMODAL_MAX_IMAGE_BYTES=8388608

# 阿里云 DashScope 大模型配置；密钥为空时系统使用可解释的本地降级结果。
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
LLM_MULTIMODAL_MODEL=qwen-vl-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.1

# 宿主机模型目录映射；MODEL_ROOT 应指向包含 bge-m3 与 reranker 的目录。
MODEL_ROOT=./models
EMBEDDING_MODEL_PATH=/models/bge-m3
EMBEDDING_MODEL_VERSION=bge-m3-local-v1
EMBEDDING_INFERENCE_BATCH_SIZE=1
EMBEDDING_MAX_LENGTH=512
RERANKER_MODEL_PATH=/models/bge-reranker-large
RERANKER_MODEL_VERSION=bge-reranker-large-local-v1
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
MODEL_DEVICE=auto
MODEL_DTYPE=auto
MODEL_CPU_THREADS=2

# 企业能力适配器。当前使用本地实现，未来可替换 OSS、企业 SSO、OA 和云监控。
LOCAL_STORAGE_PATH=/data/files
OBJECT_STORAGE_PROVIDER=local
AUTH_MODE=local
ALLOW_INSECURE_LOCAL_AUTH=false
CHECKPOINT_TTL_SECONDS=604800
CHECKPOINT_HISTORY_LIMIT=20
RUN_EVENT_STREAM_MAXLEN=2000
LOCAL_AUTH_USER_ID=local-user
LOCAL_AUTH_TENANT_ID=default
LOCAL_AUTH_ROLES=admin
LOCAL_AUTH_PROFILES=admin,planner,approver,viewer
# 仅本地开发模式开放的一键演示数据初始化开关。
DEMO_WORKSPACE_ENABLED=true
EXTERNAL_APPROVAL_PROVIDER=internal
TELEMETRY_PROVIDER=console

# 浏览器、WebSocket 与 FastMCP 的服务地址和调用超时。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
MCP_API_BASE_URL=http://api:8000/api/v1
MCP_INTERNAL_BASE_URL=http://mcp:8001
MCP_PUBLIC_BASE_URL=http://localhost:8001
MCP_PATH=/mcp
MCP_REQUEST_TIMEOUT_SECONDS=30

# 基础设施镜像版本显式锁定，避免不同开发机器拉取到不一致版本。
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:8.2-alpine
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.25
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MILVUS_IMAGE=milvusdb/milvus:v3.0.0
